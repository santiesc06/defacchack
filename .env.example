# Copia este archivo como .env y ajusta los valores. El .env NO se sube a git (tiene credenciales).
# Las variables definidas en la terminal tienen prioridad sobre este archivo.

# --- Modelo ---------------------------------------------------------------------------
CFZT_LLM=ollama
CFZT_LLM_MODEL=qwen2.5:7b
CFZT_LLM_TEMPERATURA=0
# 1 = estricto: si el modelo falla, la solicitud queda como FALLO_MODELO (nunca se usa el simulador)
CFZT_LLM_ESTRICTO=1
# CFZT_OLLAMA_URL=http://127.0.0.1:11434

# --- Base de datos de pruebas (deja UNA sin comentar) ----------------------------------
# Oracle Autonomous Database / Oracle Cloud (puerto 1522 con TLS). Requiere: pip install oracledb
# Si la clave tiene caracteres especiales (@ : / ? # %), codifícalos (p. ej. @ -> %40).
# CFZT_DB_URL=oracle+oracledb://USUARIO:CLAVE@?dsn=tcps://HOST:1522/SERVICE_NAME
# Oracle local o sin TLS (puerto 1521):
# CFZT_DB_URL=oracle+oracledb://USUARIO:CLAVE@HOST:1521/?service_name=SERVICIO
# Script .sql compatible con SQLite
# CFZT_DB_SQL=C:/ruta/archivo.sql
